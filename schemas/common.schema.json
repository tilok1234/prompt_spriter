{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-spriter.local/schemas/common.schema.json",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^r[0-9]{3,}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application",
        "model"
      ],
      "properties": {
        "application": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "animationLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startColumn",
        "frames",
        "durationMs",
        "playback"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "startColumn": {
          "type": "integer",
          "minimum": 0
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "playback": {
          "enum": [
            "loop",
            "once",
            "hold-last"
          ]
        },
        "finalFrameHoldMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

