{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-spriter.local/schemas/revision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "assetId",
    "id",
    "parentRevisionId",
    "createdAt",
    "request",
    "category",
    "style",
    "producer",
    "artifacts",
    "sheet",
    "directions",
    "animations",
    "validationReportPath",
    "batchId"
  ],
  "properties": {
    "kind": {
      "const": "revision"
    },
    "schemaVersion": {
      "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/semver"
    },
    "assetId": {
      "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/kebabId"
    },
    "id": {
      "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/revisionId"
    },
    "parentRevisionId": {
      "oneOf": [
        {
          "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/revisionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/dateTime"
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/contractRef"
    },
    "style": {
      "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/contractRef"
    },
    "producer": {
      "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/producer"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sheet",
        "thumbnail"
      ],
      "properties": {
        "source": {
          "oneOf": [
            {
              "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "sheet": {
          "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/artifact"
        },
        "thumbnail": {
          "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/artifact"
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellWidth",
        "cellHeight",
        "columns",
        "rows",
        "width",
        "height"
      ],
      "properties": {
        "cellWidth": {
          "type": "integer",
          "minimum": 1
        },
        "cellHeight": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "directions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/kebabId"
      }
    },
    "animations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/animationLayout"
      }
    },
    "validationReportPath": {
      "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/relativePath"
    },
    "batchId": {
      "oneOf": [
        {
          "$ref": "https://prompt-spriter.local/schemas/common.schema.json#/$defs/kebabId"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

